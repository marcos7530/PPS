@using POS.Application.DTOs

<div class="widget-config-panel">
    <h3>Configurar Widgets</h3>

    <div class="widget-config-panel__available">
        <h4>Tipos disponibles</h4>
        @foreach (var type in _availableTypes)
        {
            <div class="widget-config-panel__item">
                <span>@GetDisplayName(type)</span>
                <button class="btn btn--sm btn--primary"
                        disabled="@(_widgets.Count >= MaxWidgets || _widgets.Any(w => w.Type == type))"
                        @onclick="() => AddWidget(type)"
                        aria-label="Agregar widget @GetDisplayName(type)">
                    Agregar
                </button>
            </div>
        }
    </div>

    @if (_widgets.Count >= MaxWidgets)
    {
        <p class="widget-config-panel__warning">Máximo @MaxWidgets widgets alcanzado.</p>
    }

    <div class="widget-config-panel__current">
        <h4>Widgets activos (@_widgets.Count / @MaxWidgets)</h4>
        @for (int i = 0; i < _widgets.Count; i++)
        {
            var index = i;
            var w = _widgets[index];
            <div class="widget-config-panel__row">
                <span>@GetDisplayName(w.Type)</span>
                <div class="widget-config-panel__actions">
                    <button class="btn btn--sm"
                            disabled="@(index == 0)"
                            @onclick="() => MoveUp(index)"
                            aria-label="Mover arriba">&#9650;</button>
                    <button class="btn btn--sm"
                            disabled="@(index == _widgets.Count - 1)"
                            @onclick="() => MoveDown(index)"
                            aria-label="Mover abajo">&#9660;</button>
                    <button class="btn btn--sm btn--danger"
                            @onclick="() => RemoveWidget(index)"
                            aria-label="Eliminar widget">&#10005;</button>
                </div>
            </div>
        }
    </div>

    <div class="widget-config-panel__footer">
        <button class="btn btn--primary" @onclick="SaveAsync">Guardar</button>
        <button class="btn" @onclick="Cancel">Cancelar</button>
    </div>

    @if (!string.IsNullOrEmpty(_saveError))
    {
        <p class="widget-config-panel__error">@_saveError</p>
    }
</div>

@code {
    private const int MaxWidgets = 8;

    [Parameter, EditorRequired]
    public IReadOnlyList<WidgetConfig> CurrentWidgets { get; set; } = Array.Empty<WidgetConfig>();

    [Parameter]
    public EventCallback<IReadOnlyList<WidgetConfig>> OnSave { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    private List<WidgetConfig> _widgets = new();
    private string? _saveError;

    private static readonly string[] _availableTypes = WidgetConfig.Types.All.ToArray();

    protected override void OnParametersSet()
    {
        _widgets = CurrentWidgets.OrderBy(w => w.Position).ToList();
    }

    private void AddWidget(string type)
    {
        if (_widgets.Count >= MaxWidgets) return;
        if (_widgets.Any(w => w.Type == type)) return;
        _widgets.Add(new WidgetConfig(type, _widgets.Count));
    }

    private void RemoveWidget(int index)
    {
        _widgets.RemoveAt(index);
        RenumberPositions();
    }

    private void MoveUp(int index)
    {
        if (index <= 0) return;
        (_widgets[index], _widgets[index - 1]) = (_widgets[index - 1], _widgets[index]);
        RenumberPositions();
    }

    private void MoveDown(int index)
    {
        if (index >= _widgets.Count - 1) return;
        (_widgets[index], _widgets[index + 1]) = (_widgets[index + 1], _widgets[index]);
        RenumberPositions();
    }

    private void RenumberPositions()
    {
        for (int i = 0; i < _widgets.Count; i++)
        {
            _widgets[i] = _widgets[i] with { Position = i };
        }
    }

    private async Task SaveAsync()
    {
        _saveError = null;
        RenumberPositions();
        await OnSave.InvokeAsync(_widgets.AsReadOnly());
    }

    private async Task Cancel()
    {
        await OnCancel.InvokeAsync();
    }

    private static string GetDisplayName(string type) => type switch
    {
        WidgetConfig.Types.DailySalesLine => "Ventas Diarias (Línea)",
        WidgetConfig.Types.TopProductsBar => "Top Productos (Barras)",
        WidgetConfig.Types.SalesByCategoryPie => "Ventas por Categoría (Torta)",
        WidgetConfig.Types.TotalSalesNumeric => "Total Ventas (Numérico)",
        _ => type
    };
}
