@using POS.Application.DTOs
@using POS.Application.Interfaces.Services
@using POS.Domain.Common

@inject IElevationService ElevationService

@if (IsVisible)
{
    <div class="modal-overlay" @onclick="Cancel" aria-modal="true" role="dialog" aria-labelledby="manager-auth-title">
        <div class="modal-dialog" @onclick:stopPropagation="true">
            <header class="modal-dialog__header">
                <h2 id="manager-auth-title">Autorización de Gerente</h2>
            </header>

            <div class="modal-dialog__body">
                <p class="modal-dialog__description">
                    Se requiere autorización de un gerente o administrador para continuar.
                </p>

                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="modal-dialog__error" role="alert" aria-live="assertive">
                        @_errorMessage
                    </div>
                }

                <div class="modal-dialog__field">
                    <label for="manager-username">Usuario</label>
                    <input id="manager-username"
                           type="text"
                           autocomplete="username"
                           @bind="_username"
                           @bind:event="oninput"
                           disabled="@_isProcessing"
                           placeholder="Nombre de usuario del gerente" />
                </div>

                <div class="modal-dialog__field">
                    <label for="manager-password">Contraseña</label>
                    <input id="manager-password"
                           type="password"
                           autocomplete="current-password"
                           @bind="_password"
                           @bind:event="oninput"
                           disabled="@_isProcessing"
                           @onkeydown="OnPasswordKeyDown" />
                </div>
            </div>

            <footer class="modal-dialog__footer">
                <button type="button"
                        class="btn btn--secondary"
                        @onclick="Cancel"
                        disabled="@_isProcessing">
                    Cancelar
                </button>
                <button type="button"
                        class="btn btn--primary"
                        @onclick="Authorize"
                        disabled="@(_isProcessing || string.IsNullOrWhiteSpace(_username) || string.IsNullOrWhiteSpace(_password))">
                    @if (_isProcessing)
                    {
                        <span>Verificando...</span>
                    }
                    else
                    {
                        <span>Autorizar</span>
                    }
                </button>
            </footer>
        </div>
    </div>
}

@code {
    private string _username = string.Empty;
    private string _password = string.Empty;
    private string? _errorMessage;
    private bool _isProcessing;

    /// <summary>
    /// Controls visibility of the dialog.
    /// </summary>
    [Parameter]
    public bool IsVisible { get; set; }

    /// <summary>
    /// The permission being requested (e.g., "ApplyDiscount", "ProcessReturn").
    /// </summary>
    [Parameter]
    public string RequiredPermission { get; set; } = string.Empty;

    /// <summary>
    /// The ID of the user requesting the elevation.
    /// </summary>
    [Parameter]
    public Guid RequestingUserId { get; set; }

    /// <summary>
    /// Callback with the ElevationGrant on success, or null on cancellation.
    /// </summary>
    [Parameter]
    public EventCallback<ElevationGrant?> OnAuthResult { get; set; }

    private async Task OnPasswordKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_username) && !string.IsNullOrWhiteSpace(_password))
        {
            await Authorize();
        }
    }

    private async Task Authorize()
    {
        if (_isProcessing) return;

        _isProcessing = true;
        _errorMessage = null;

        try
        {
            var request = new ElevationRequest(
                _username.Trim(),
                _password,
                RequiredPermission,
                RequestingUserId);

            var result = await ElevationService.AuthorizeAsync(request, CancellationToken.None);

            if (result.IsSuccess)
            {
                ResetForm();
                await OnAuthResult.InvokeAsync(result.Value);
            }
            else
            {
                _errorMessage = result.Error?.Code switch
                {
                    ErrorCode.InvalidCredentials => "Credenciales inválidas.",
                    ErrorCode.InsufficientPermissions => "El usuario no tiene permisos de gerente.",
                    ErrorCode.AccountLocked => "La cuenta está bloqueada.",
                    _ => "Error de autorización. Intente nuevamente."
                };
            }
        }
        catch
        {
            _errorMessage = "Error de conexión. Intente nuevamente.";
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private async Task Cancel()
    {
        ResetForm();
        await OnAuthResult.InvokeAsync(null);
    }

    private void ResetForm()
    {
        _username = string.Empty;
        _password = string.Empty;
        _errorMessage = null;
    }
}
