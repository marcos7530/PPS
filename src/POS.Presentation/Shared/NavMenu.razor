@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing

<ul class="nav-menu" role="navigation">
    @* Dashboard — all roles *@
    <AuthorizeView Policy="@AuthorizationPolicies.RequireViewer">
        <li class="nav-menu__item">
            <NavLink class="nav-menu__link" href="/" Match="NavLinkMatch.All" @onclick="HandleNavigated">
                <svg class="nav-menu__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <rect x="3" y="3" width="7" height="7" /><rect x="14" y="3" width="7" height="7" />
                    <rect x="3" y="14" width="7" height="7" /><rect x="14" y="14" width="7" height="7" />
                </svg>
                <span>Dashboard</span>
            </NavLink>
        </li>
    </AuthorizeView>

    @* POS — Cashier+ *@
    <AuthorizeView Policy="@AuthorizationPolicies.RequireCashier">
        <li class="nav-menu__item">
            <NavLink class="nav-menu__link" href="pos" Match="NavLinkMatch.Prefix" @onclick="HandleNavigated">
                <svg class="nav-menu__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <rect x="2" y="4" width="20" height="16" rx="2" /><line x1="2" y1="10" x2="22" y2="10" />
                </svg>
                <span>POS</span>
            </NavLink>
        </li>
    </AuthorizeView>

    @* Shifts — Cashier+ *@
    <AuthorizeView Policy="@AuthorizationPolicies.RequireCashier">
        <li class="nav-menu__item">
            <NavLink class="nav-menu__link" href="shifts" Match="NavLinkMatch.Prefix" @onclick="HandleNavigated">
                <svg class="nav-menu__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" />
                </svg>
                <span>Turnos</span>
            </NavLink>
        </li>
    </AuthorizeView>

    @* Customers — Cashier+ *@
    <AuthorizeView Policy="@AuthorizationPolicies.RequireCashier">
        <li class="nav-menu__item">
            <NavLink class="nav-menu__link" href="customers" Match="NavLinkMatch.Prefix" @onclick="HandleNavigated">
                <svg class="nav-menu__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" />
                </svg>
                <span>Clientes</span>
            </NavLink>
        </li>
    </AuthorizeView>

    @* Inventory — Manager+ *@
    <AuthorizeView Policy="@AuthorizationPolicies.RequireManager">
        <li class="nav-menu__item">
            <NavLink class="nav-menu__link" href="inventory" Match="NavLinkMatch.Prefix" @onclick="HandleNavigated">
                <svg class="nav-menu__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
                </svg>
                <span>Inventario</span>
            </NavLink>
        </li>
    </AuthorizeView>

    @* Reports — Manager+ *@
    <AuthorizeView Policy="@AuthorizationPolicies.RequireManager">
        <li class="nav-menu__item">
            <NavLink class="nav-menu__link" href="reports" Match="NavLinkMatch.Prefix" @onclick="HandleNavigated">
                <svg class="nav-menu__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <line x1="18" y1="20" x2="18" y2="10" /><line x1="12" y1="20" x2="12" y2="4" />
                    <line x1="6" y1="20" x2="6" y2="14" />
                </svg>
                <span>Informes</span>
            </NavLink>
        </li>
    </AuthorizeView>

    @* Users — Admin only *@
    <AuthorizeView Policy="@AuthorizationPolicies.RequireAdministrator">
        <li class="nav-menu__item">
            <NavLink class="nav-menu__link" href="users" Match="NavLinkMatch.Prefix" @onclick="HandleNavigated">
                <svg class="nav-menu__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" />
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" />
                </svg>
                <span>Usuarios</span>
            </NavLink>
        </li>
    </AuthorizeView>

    @* Settings — Admin only *@
    <AuthorizeView Policy="@AuthorizationPolicies.RequireAdministrator">
        <li class="nav-menu__item">
            <NavLink class="nav-menu__link" href="settings" Match="NavLinkMatch.Prefix" @onclick="HandleNavigated">
                <svg class="nav-menu__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <circle cx="12" cy="12" r="3" />
                    <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" />
                </svg>
                <span>Configuración</span>
            </NavLink>
        </li>
    </AuthorizeView>

    @* Audit — Admin only *@
    <AuthorizeView Policy="@AuthorizationPolicies.RequireAdministrator">
        <li class="nav-menu__item">
            <NavLink class="nav-menu__link" href="audit" Match="NavLinkMatch.Prefix" @onclick="HandleNavigated">
                <svg class="nav-menu__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                    <polyline points="14 2 14 8 20 8" /><line x1="16" y1="13" x2="8" y2="13" />
                    <line x1="16" y1="17" x2="8" y2="17" /><polyline points="10 9 9 9 8 9" />
                </svg>
                <span>Auditoría</span>
            </NavLink>
        </li>
    </AuthorizeView>
</ul>

@code {
    [Parameter]
    public EventCallback OnNavigated { get; set; }

    private async Task HandleNavigated()
    {
        await OnNavigated.InvokeAsync();
    }
}
